# ============= 基础配置 =============
APP_NAME=SQL核验服务
APP_VERSION=1.0.0
ENVIRONMENT=dev
DEBUG=true

# ============= 数据库配置 =============
# 方式1: 使用完整的数据库URL
# DATABASE_URL=mysql+pymysql://username:password@host:port/database

# 方式2: 使用分离的配置变量
MYSQL_DATABASE_HOST=localhost
MYSQL_DATABASE_PORT=3306
MYSQL_DATABASE_USERNAME=sqlfluff_user
MYSQL_DATABASE_PASSWORD=sqlfluff_password
MYSQL_DATABASE_NAME=sqlfluff_service

# ============= NFS共享目录配置 =============
NFS_SHARE_ROOT_PATH=/mnt/nfs/sqlfluff

# ============= Worker 配置（DB-as-Queue） =============
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=2.0
WORKER_HEARTBEAT_INTERVAL=30
WORKER_ZOMBIE_TIMEOUT=600
WORKER_TASK_TIMEOUT=1800
WORKER_ZOMBIE_SWEEP_INTERVAL=120
WORKER_MAX_RETRIES=3

# ============= Consul服务发现配置 =============
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
# 兼容别名：若设置 CONSUL_URL，会覆盖 CONSUL_HOST
# CONSUL_URL=127.0.0.1
# 必须设置: 服务注册的IP地址（替换为你的服务器IP）
CONSUL_SERVICE_IP=192.168.1.100
# 可选: 手动指定服务实例ID（默认自动生成：服务名-主机名-端口号）
# CONSUL_SERVICE_ID=sql-linting-service-custom-id

# ============= Web服务配置 =============
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_WORKERS=1
# 部署脚本常用别名（gunicorn / start_web）
# PORT=8000
# GUNICORN_WORKERS=4

# ============= 日志配置 =============
LOG_LEVEL=INFO
LOG_FORMAT=json
# 生产启动脚本会分别设置为 web.log / worker.log，避免混写
LOG_FILE_PATH=/var/log/sqlfluff-service.log
LOG_FILE_BACKUP_COUNT=14
# 打印每条 SQL（默认关闭；Worker 轮询会严重刷屏）
DATABASE_ECHO=false

# ============= SQLFluff / 方言规则（可选） =============
# SQLFLUFF_DIALECT=mysql
# SQLFLUFF_CONFIG_PATH=/path/to/sqlfluff/config
# HIVE_RULES=
# GBASE8A_RULES=

# ============= HTML报告导出（可选） =============
# EXPORT_HTML_FILE_LIMIT=100
# EXPORT_HTML_CONTEXT_LINES=3
