# ============= 基础配置 =============
APP_NAME=SQL核验服务
APP_VERSION=1.0.0
ENVIRONMENT=dev
DEBUG=true

# ============= 数据库配置 =============
# 方式1: 使用完整的数据库URL
# DATABASE_URL=mysql+pymysql://username:password@host:port/database

# 方式2: 使用分离的配置变量
MYSQL_DATABASE_HOST=localhost
MYSQL_DATABASE_PORT=3306
MYSQL_DATABASE_USERNAME=sqlfluff_user
MYSQL_DATABASE_PASSWORD=sqlfluff_password
MYSQL_DATABASE_NAME=sqlfluff_service

# ============= Redis配置 =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB_BROKER=0
REDIS_DB_RESULT=1

# ============= NFS共享目录配置 =============
NFS_SHARE_ROOT_PATH=/mnt/nfs/sqlfluff

# ============= Consul服务发现配置 =============
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
# 必须设置: 服务注册的IP地址（替换为你的服务器IP）
CONSUL_SERVICE_IP=192.168.1.100

# ============= Web服务配置 =============
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_WORKERS=1

# ============= 任务处理配置 =============
MAX_CONCURRENT_TASKS=8

# ============= 日志配置 =============
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/sqlfluff-service.log
